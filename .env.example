# 运行 npm run setup 会自动生成 .env；也可以复制本文件为 .env 后手动填写。
# 口令可以是任意非空字符串（不能含空格）。
ACCESS_TOKEN=
AGENT_TOKEN=

# 以下两项由 npm run deploy 自动写入，无需手动填写：
# SITE_URL=https://relay-todo-demo.pages.dev
# RELAY_URL=wss://relay-todo-demo.pages.dev/agent/connect

# 可选：本机 API 端口（默认 8080）、数据库路径（默认 ./data/todos.db）
# PORT=8080
# DB_PATH=./data/todos.db

# 可选：登录的 Cloudflare 用户有多个账号时，指定部署到哪个账号（npx wrangler whoami 可查看 Account ID）
# CLOUDFLARE_ACCOUNT_ID=
